// Skopiuj do Secrets.xcconfig i uzupełnij. NIE commituj Secrets.xcconfig.
// Uwaga: w xcconfig "//" rozpoczyna komentarz — dlatego podajemy sam host, bez https://
SUPABASE_HOST = abcdefghijklmnop.supabase.co
// Klucz "publishable" (sb_publishable_...) lub legacy "anon". NIGDY klucz secret/service_role!
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEWSFLOW_TEAM_ID = ABCDE12345
NEWSFLOW_BUNDLE_ID = pl.twojanazwa.newsflow
